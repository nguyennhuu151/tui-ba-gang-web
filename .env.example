# Xem chi tiết đầy đủ tại docs/environment-variables.md
# File này KHÔNG chứa giá trị thật — copy thành .env.local rồi điền giá trị thật (không commit .env.local)

# --- ezCloud (server-only) — [CHƯA XÁC NHẬN API], tên biến có thể thay đổi khi có tài liệu chính thức ---
EZCLOUD_API_BASE_URL=
EZCLOUD_API_KEY=
EZCLOUD_HOTEL_ID_CENTRAL=
EZCLOUD_HOTEL_ID_EMBER=
EZCLOUD_HOTEL_ID_LITTLEBAY=

# --- Public (an toàn khi lộ ra Frontend) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ZALO_LINK_CENTRAL=
NEXT_PUBLIC_ZALO_LINK_EMBER=
NEXT_PUBLIC_ZALO_LINK_LITTLEBAY=
