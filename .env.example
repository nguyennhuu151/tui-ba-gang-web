# Xem chi tiết đầy đủ tại docs/environment-variables.md
# File này KHÔNG chứa giá trị thật — copy thành .env.local rồi điền giá trị thật (không commit .env.local)

# --- ezCloud (server-only) — [CHƯA XÁC NHẬN API], tên biến có thể thay đổi khi có tài liệu chính thức ---
EZCLOUD_API_BASE_URL=
EZCLOUD_API_KEY=
EZCLOUD_HOTEL_ID_CENTRAL=
EZCLOUD_HOTEL_ID_EMBER=
EZCLOUD_HOTEL_ID_LITTLEBAY=

# --- Public (an toàn khi lộ ra Frontend) ---
# Bắt buộc đặt đúng domain thật khi deploy (dùng cho Open Graph, sitemap.xml, robots.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ZALO_LINK_CENTRAL=
NEXT_PUBLIC_ZALO_LINK_EMBER=
NEXT_PUBLIC_ZALO_LINK_LITTLEBAY=

# --- SEO ---
# Trên Vercel không cần: chỉ bản Production (VERCEL_ENV=production) mới cho phép index.
# Tự host (ngoài Vercel): đặt true CHỈ trên môi trường production thật.
SITE_INDEXABLE=

# --- Chatbot (chatbot/backend) ---
# URL backend chatbot, vd. https://chat-api.example.com. Dev để trống = http://localhost:8080.
# Production để trống = ẩn nút chat. Nhớ thêm domain website vào ALLOWED_ORIGINS của backend.
NEXT_PUBLIC_CHATBOT_API_URL=
